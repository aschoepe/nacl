if {[lsearch [namespace children] ::tcltest] == -1} {
  package require tcltest 2
  namespace import -force ::tcltest::*
  loadTestedCommands
}

package require nacl

if {[lsearch -exact [nacl::randombytes names] urandom] > -1} {
  nacl::randombytes source urandom
}

set m1 [binary decode hex cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd]
set k1 [binary decode hex 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20]
set a1 [binary decode hex 372efcf9b40b35c2115b1346903d2ef42fced46f0846e7257bb156d3d7b30d3f]

test auth-1.1 {auth takes args} -body {
  nacl::auth
} -returnCodes error -result "wrong # args: should be \"nacl::auth ?command? ?-option? ...\""

test auth-1.2 {auth info} {
  list [catch {nacl::auth info} l] $l
} {0 {auth 32 key 32}}

test auth-1.3 {auth hmac512256} {
  set m2 {what do ya want for nothing?}
  set k2 Jefe[string repeat \x00 28]
  list [nacl::auth -hmac512256 auth $m2 $k2] [binary encode hex $auth]
} {0 164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea250554}

test auth-1.4 {auth hmac256} {
  list [nacl::auth -hmac256 auth $m1 $k1] $auth
} [list 0 $a1]

test auth-1.5 {auth verify hmac256} {
  nacl::auth verify -hmac256 $a1 $m1 $k1
} 0

#
# RFC 4231 section 4 test vectors. The key is handed over unchanged in
# whatever length it has and gets prepared by nacl::auth as required by
# RFC 2104 section 2. For -hmac512256 the RFC 4231 HMAC-SHA-512 result
# truncated to crypto_auth_BYTES applies, for -hmac512 the full 64 byte
# result of the RFC -- the fifth column is the second half of it.
#

set rfc4231 {}
lappend rfc4231 [list 1 [binary decode hex [string repeat 0b 20]] {Hi There} \
  b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7 \
  87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cde \
  daa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854]
lappend rfc4231 [list 2 Jefe {what do ya want for nothing?} \
  5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843 \
  164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea250554 \
  9758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737]
lappend rfc4231 [list 3 [binary decode hex [string repeat aa 20]] \
  [binary decode hex [string repeat dd 50]] \
  773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe \
  fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39 \
  bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb]
lappend rfc4231 [list 4 [binary decode hex 0102030405060708090a0b0c0d0e0f10111213141516171819] \
  [binary decode hex [string repeat cd 50]] \
  82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b \
  b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3db \
  a91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd]
lappend rfc4231 [list 5 [binary decode hex [string repeat 0c 20]] {Test With Truncation} \
  a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5 \
  415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008 \
  711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b]
lappend rfc4231 [list 6 [binary decode hex [string repeat aa 131]] \
  {Test Using Larger Than Block-Size Key - Hash Key First} \
  60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54 \
  80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f352 \
  6b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598]
lappend rfc4231 [list 7 [binary decode hex [string repeat aa 131]] \
  {This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.} \
  9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2 \
  e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944 \
  b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58]

#
# RFC 4231 defines the same seven cases for HMAC-SHA-224 and HMAC-SHA-384.
# Keyed by test case number, the tag of each in full length. Cases 6 and 7
# carry a 131 byte key and are the ones that exercise the key preparation:
# it has to shorten with SHA-224 and SHA-384, not with the hash of equal
# block size, since those have a different initial state.
#

array set rfc4231x {}
set rfc4231x(1) {896fb1128abbdf196832107cd49df33f47b4b1169912ba4f53684b22
  afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6}
set rfc4231x(2) {a30e01098bc6dbbf45690f3a7e9e6d0f8bbea2a39e6148008fd05e44
  af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649}
set rfc4231x(3) {7fb3cb3588c6c1f6ffa9694d7d6ad2649365b0c1f65d69d1ec8333ea
  88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27}
set rfc4231x(4) {6c11506874013cac6a2abc1bb382627cec6a90d86efc012de7afec5a
  3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb}
set rfc4231x(5) {0e2aea68a90c8d37c988bcdb9fca6fa8099cd857c7ec4a1815cac54c
  3abf34c3503b2a23a46efc619baef897f4c8e42c934ce55ccbae9740fcbc1af4ca62269e2a37cd88ba926341efe4aeea}
set rfc4231x(6) {95e9a0db962095adaebe9b2d6f0dbce2d499f112f2d2b7273fa6870e
  4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952}
set rfc4231x(7) {3a854166ac5d9f023f54d517d0b39dbd946770db9c2b95c9f6f565d1
  6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e}

foreach tc $rfc4231 {
  lassign $tc nr key msg e256 e512 e512tail
  lassign $rfc4231x($nr) e224 e384

  test auth-9.$nr "auth hmac224 rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac224 auth $msg $key
    binary encode hex $auth
  } $e224

  test auth-10.$nr "auth hmac384 rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac384 auth $msg $key
    binary encode hex $auth
  } $e384

  test auth-11.$nr "auth verify hmac224 and hmac384 rfc 4231 tc $nr" {
    nacl::auth -hmac224 auth  $msg $key
    nacl::auth -hmac384 auth2 $msg $key
    list [nacl::auth verify -hmac224 $auth  $msg $key] \
	 [nacl::auth verify -hmac384 $auth2 $msg $key]
  } {0 0}

  test auth-2.$nr "auth hmac256 rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac256 auth $msg $key
    binary encode hex $auth
  } $e256

  test auth-3.$nr "auth hmac512256 rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac512256 auth $msg $key
    binary encode hex $auth
  } $e512

  test auth-4.$nr "auth verify rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac256 auth $msg $key
    nacl::auth -hmac512256 auth2 $msg $key
    list [nacl::auth verify -hmac256 $auth $msg $key] \
	 [nacl::auth verify -hmac512256 $auth2 $msg $key]
  } {0 0}

  test auth-6.$nr "auth hmac512 rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac512 auth $msg $key
    binary encode hex $auth
  } $e512$e512tail

  test auth-7.$nr "auth verify hmac512 rfc 4231 tc $nr, key [string length $key] bytes" {
    nacl::auth -hmac512 auth $msg $key
    nacl::auth verify -hmac512 $auth $msg $key
  } 0
}

#
# A key of block size is neither hashed nor padded. This is the length a
# client secret of an OpenID Connect provider typically has, and the case
# that no zero padding of a 32 byte key can reach.
#

test auth-5.1 {auth hmac256 key of block size} {
  nacl::auth -hmac256 auth {Hi There} [string repeat A 64]
  binary encode hex $auth
} f648295f5ebc1fbfc3cbffe85c56aefaf649b2f8546ecd275b9437df56e5a1c0

test auth-5.2 {auth hmac256 empty key} {
  nacl::auth -hmac256 auth {Hi There} {}
  binary encode hex $auth
} e48411262715c8370cd5e7bf8e82bef53bd53712d007f3429351843b77c7bb9b

test auth-5.3 {auth hmac512256 short key equals zero padded key} {
  nacl::auth -hmac512256 auth {what do ya want for nothing?} Jefe
  nacl::auth -hmac512256 auth2 {what do ya want for nothing?} Jefe[string repeat \x00 28]
  string equal $auth $auth2
} 1

test auth-5.4 {auth verify rejects a wrong key} {
  nacl::auth -hmac256 auth {Hi There} [string repeat A 64]
  nacl::auth verify -hmac256 $auth {Hi There} [string repeat A 63]
} -1

#
# -hmac512 is the untruncated HMAC-SHA-512 that RFC 7518 HS512 is defined
# on. NaCl has no such primitive; crypto_auth is the same computation cut
# to 32 bytes, which is what -hmac512256 exposes.
#

test auth-8.1 {auth hmac512 yields a 64 byte tag} {
  nacl::auth -hmac512 auth {Hi There} [string repeat A 64]
  string length $auth
} 64

test auth-8.2 {hmac512 starts with the hmac512256 tag} {
  nacl::auth -hmac512    auth  {Hi There} Jefe
  nacl::auth -hmac512256 auth2 {Hi There} Jefe
  string equal [string range $auth 0 31] $auth2
} 1

test auth-8.3 {verify hmac512 rejects a tag of the truncated length} {
  nacl::auth -hmac512256 auth {Hi There} Jefe
  list [catch {nacl::auth verify -hmac512 $auth {Hi There} Jefe} e] $e
} {1 {wrong # auth length 64 bytes required}}

test auth-8.4 {verify hmac512256 rejects a tag of the full length} {
  nacl::auth -hmac512 auth {Hi There} Jefe
  list [catch {nacl::auth verify -hmac512256 $auth {Hi There} Jefe} e] $e
} {1 {wrong # auth length 32 bytes required}}

test auth-8.5 {verify hmac512 rejects a wrong key} {
  nacl::auth -hmac512 auth {Hi There} [string repeat A 64]
  nacl::auth verify -hmac512 $auth {Hi There} [string repeat A 63]
} -1

test auth-8.6 {verify hmac512 rejects a flipped bit in the second half} {
  nacl::auth -hmac512 auth {Hi There} Jefe
  set bad $auth
  set b [scan [string index $bad 40] %c]
  set bad [string replace $bad 40 40 [format %c [expr {$b ^ 1}]]]
  nacl::auth verify -hmac512 $bad {Hi There} Jefe
} -1

test auth-8.7 {hmac512 key of block size, no truncation involved} {
  nacl::auth -hmac512 auth {Hi There} [string repeat A 64]
  string length [binary encode hex $auth]
} 128

#
# -hmac224 and -hmac384 complete the four algorithms RFC 4231 defines, and
# with -hmac384 the HS384 of RFC 7518 becomes reachable.
#

test auth-12.1 {tag lengths of all five variants} {
    set r {}
    foreach opt {-hmac224 -hmac256 -hmac384 -hmac512256 -hmac512} {
	nacl::auth $opt auth {Hi There} Jefe
	lappend r [string length $auth]
    }
    set r
} {28 32 48 32 64}

test auth-12.2 {verify hmac224 insists on 28 bytes} {
    nacl::auth -hmac256 auth {Hi There} Jefe
    list [catch {nacl::auth verify -hmac224 $auth {Hi There} Jefe} e] $e
} {1 {wrong # auth length 28 bytes required}}

test auth-12.3 {verify hmac384 insists on 48 bytes} {
    nacl::auth -hmac512 auth {Hi There} Jefe
    list [catch {nacl::auth verify -hmac384 $auth {Hi There} Jefe} e] $e
} {1 {wrong # auth length 48 bytes required}}

test auth-12.4 {hmac224 is not a prefix of hmac256} {
    nacl::auth -hmac224 auth  {Hi There} Jefe
    nacl::auth -hmac256 auth2 {Hi There} Jefe
    string equal $auth [string range $auth2 0 27]
} 0

test auth-12.5 {hmac384 is not a prefix of hmac512} {
    nacl::auth -hmac384 auth  {Hi There} Jefe
    nacl::auth -hmac512 auth2 {Hi There} Jefe
    string equal $auth [string range $auth2 0 47]
} 0

test auth-12.6 {verify hmac224 rejects a flipped last byte} {
    nacl::auth -hmac224 auth {Hi There} Jefe
    binary scan $auth cu* b
    lset b end [expr {[lindex $b end] ^ 0xff}]
    nacl::auth verify -hmac224 [binary format cu* $b] {Hi There} Jefe
} -1

test auth-12.7 {verify hmac384 rejects a flipped last byte} {
    nacl::auth -hmac384 auth {Hi There} Jefe
    binary scan $auth cu* b
    lset b end [expr {[lindex $b end] ^ 0xff}]
    nacl::auth verify -hmac384 [binary format cu* $b] {Hi There} Jefe
} -1

# cleanup
::tcltest::cleanupTests
return
